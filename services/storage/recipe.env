SOURCE_DIR="sources/storage"
SOURCE_REF="v1.62.6"
# Native-first (HOST_NATIVE_PLAN.md): services/storage/build-host.sh builds
# the rolldown JS bundle + bin/storage wrapper for every target (shared Node
# runtime, Phase 4 Option A); the Docker image is derived from the artifact's
# app/ tree on the distroless Node base via Dockerfile.slim.
ARTIFACT_BACKEND="docker-source"
ARTIFACT_SOURCE_BUILD="host"
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
PORTABLE="true"
# No FLOOR_CHECK_CMD: the artifact is a JS bundle with no bundled runtime;
# host compatibility is the shared Node runtime's contract
# (runtime_requires in the manifest), which the CLI enforces.
RUNTIME_REQUIRES="node>=20"
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/storage-api:v1.62.6}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-gcr.io/distroless/nodejs24-debian13:nonroot}"
ENTRYPOINT_JSON='["/nodejs/bin/node"]'
CMD_JSON='["dist/start/server.js"]'
