SOURCE_DIR="sources/storage"
SOURCE_REF="v1.62.6"
ARTIFACT_BACKEND="docker-source"
ARTIFACT_DOCKERFILE="Dockerfile.artifact.rolldown"
# Darwin host-native artifacts: rolldown JS bundle + bin/storage wrapper
# resolving the shared Node runtime (HOST_NATIVE_PLAN.md Phase 4, Option A).
# Built by services/storage/build-host.sh; linux keeps the Docker builder
# unchanged.
if [[ "$(target_os)" == "darwin" ]]; then
  SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
  PORTABLE="true"
  RUNTIME_REQUIRES="node>=20"
fi
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/storage-api:v1.62.6}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-gcr.io/distroless/nodejs24-debian13:nonroot}"
ENTRYPOINT_JSON='["/nodejs/bin/node"]'
CMD_JSON='["dist/start/server.js"]'
INCLUDE_PATHS=(
  "/app/package.json"
  "/app/dist"
  "/app/node_modules"
  "/app/migrations"
)
INCLUDE_PATHS_JSON='["/app/package.json","/app/dist","/app/node_modules","/app/migrations"]'
ARTIFACT_BUILD_ARGS=(
  "LOCAL_RUNTIME_PRUNE=${LOCAL_RUNTIME_PRUNE:-0}"
  "ROLLDOWN_MINIFY=${ROLLDOWN_MINIFY:-1}"
)
