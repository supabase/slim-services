# syntax=docker/dockerfile:1.7
ARG SOURCE_DIR=sources/storage
ARG ROLLDOWN_VERSION=1.0.0-rc.17
ARG LOCAL_RUNTIME_PRUNE=0
ARG ROLLDOWN_MINIFY=0

FROM node:24-bookworm-slim AS build
ARG SOURCE_DIR
ARG ROLLDOWN_VERSION
ARG LOCAL_RUNTIME_PRUNE
ARG ROLLDOWN_MINIFY
WORKDIR /app
RUN npm install -g "rolldown@${ROLLDOWN_VERSION}"
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential ca-certificates git python3 \
  && rm -rf /var/lib/apt/lists/*
COPY ${SOURCE_DIR}/package.json ${SOURCE_DIR}/package-lock.json ./
RUN npm ci
COPY ${SOURCE_DIR}/ ./
COPY services/storage/overlay /tmp/slim-overlay
RUN npm run build \
  && if [ "$LOCAL_RUNTIME_PRUNE" = "1" ]; then node /tmp/slim-overlay/prune-local-runtime.mjs /app; fi \
  && cp /tmp/slim-overlay/rolldown.config.mjs ./rolldown.config.mjs \
  && cp /tmp/slim-overlay/bundle-manifest.mjs ./bundle-manifest.mjs \
  && mkdir -p ./scripts \
  && cp /tmp/slim-overlay/scripts/prepare-bundle-dist.mjs ./scripts/prepare-bundle-dist.mjs \
  && if [ "$ROLLDOWN_MINIFY" = "1" ]; then rolldown -c ./rolldown.config.mjs --minify; else rolldown -c ./rolldown.config.mjs; fi \
  && node ./scripts/prepare-bundle-dist.mjs \
  && find /app/dist-bundle /app/dist-bundle/node_modules \
      \( -name '*.d.ts' -o -name '*.d.ts.map' -o -name '*.map' -o -name '*.md' -o -name '*.markdown' -o -name 'LICENSE*' -o -name 'README*' -o -name '*.test.js' -o -name '*.test.js.map' \) \
      -type f -print0 | xargs -0r rm -f \
  && find /app/dist-bundle/node_modules \
      \( -path '*/test/*' -o -path '*/tests/*' -o -path '*/__tests__/*' -o -path '*/example/*' -o -path '*/examples/*' -o -path '*/benchmark/*' -o -path '*/benchmarks/*' \) \
      -print0 | xargs -0r rm -rf

FROM scratch AS artifact
COPY --from=build /app/dist-bundle/package.json /app/package.json
COPY --from=build /app/dist-bundle/start /app/dist/start
COPY --from=build /app/dist-bundle/static /app/dist/static
COPY --from=build /app/dist-bundle/node_modules /app/node_modules
COPY --from=build /app/migrations /app/migrations
