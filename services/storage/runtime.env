# Low-footprint local-dev defaults, baked as image ENV (overridable at runtime).
# V8 heap cap + tiny semi-spaces keep the Node process lean at 25 parallel stacks.
NODE_OPTIONS=--max-old-space-size=128 --max-semi-space-size=2
# Client pool holds server-side postgres backends (upstream default 20).
DATABASE_MAX_CONNECTIONS=2
# Image transformation requires imgproxy; off by default for local dev.
IMAGE_TRANSFORMATION_ENABLED=false
