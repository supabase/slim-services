# syntax=docker/dockerfile:1.7
ARG SOURCE_DIR=sources/storage

FROM node:24-bookworm-slim AS build
ARG SOURCE_DIR
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential ca-certificates python3 \
  && rm -rf /var/lib/apt/lists/*
COPY ${SOURCE_DIR}/package.json ${SOURCE_DIR}/package-lock.json ./
COPY ${SOURCE_DIR}/patches ./patches
RUN npm ci
COPY ${SOURCE_DIR}/ ./
COPY services/storage/overlay/prune-local-runtime.mjs /tmp/prune-local-runtime.mjs
RUN npm run build \
  && npm prune --omit=dev \
  && find /app/dist /app/node_modules \
      \( -name '*.d.ts' -o -name '*.d.ts.map' -o -name '*.map' -o -name '*.md' -o -name '*.markdown' -o -name 'LICENSE*' -o -name 'README*' -o -name '*.test.js' -o -name '*.test.js.map' \) \
      -type f -print0 | xargs -0r rm -f \
  && find /app/node_modules \
      \( -path '*/test/*' -o -path '*/tests/*' -o -path '*/__tests__/*' -o -path '*/example/*' -o -path '*/examples/*' -o -path '*/benchmark/*' -o -path '*/benchmarks/*' \) \
      -print0 | xargs -0r rm -rf \
  && node /tmp/prune-local-runtime.mjs /app

FROM scratch AS artifact
COPY --from=build /app/package.json /app/package.json
COPY --from=build /app/dist /app/dist
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/migrations /app/migrations
