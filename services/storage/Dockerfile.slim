# syntax=docker/dockerfile:1.7
# Derived image: distroless base + the portable artifact's app/ tree and its
# bundled Node runtime (bin/storage host wrapper is unused in Docker — the
# entrypoint execs the bundled node directly).
ARG BASE_IMAGE=gcr.io/distroless/base-debian13:nonroot

# Static busybox for the one RUN below; bind-mounted at build time only,
# never shipped in the image.
FROM debian:trixie-slim AS tools
RUN apt-get update -y && apt-get install -y --no-install-recommends busybox-static \
  && mkdir -p /out && cp /bin/busybox /out/busybox

FROM ${BASE_IMAGE}
ARG ARTIFACT_ROOT
WORKDIR /app
ENV NODE_ENV=production
# The distroless base ships /home/nonroot as 0700. Local stacks mount the
# file-backend named volume there (the only writable home for uid 65532), and
# docker seeds a fresh volume's root from the image path, so sidecars running
# as another uid (imgproxy runs as 999) cannot traverse into the volume.
# Re-mode the home to 0711: contents stay private by default, but other uids
# can traverse to the world-readable objects the API writes below it.
# A RUN chmod diff layer is the only reliable way to do this: COPY onto a
# directory that already exists in the base — with or without --link — merges
# contents but keeps the existing directory's metadata (the image smoke caught
# /home/nonroot still 0700 both ways). The stage runs as nonroot, which owns
# the directory, so no root round-trip is needed.
RUN --mount=from=tools,source=/out,target=/tools ["/tools/busybox", "chmod", "0711", "/home/nonroot"]
# docker.io stacks mount the file-backend volume at /mnt; ship the same
# mountpoint owned by 65532 so a fresh named volume seeds writable for the
# API (0755: sidecars on other uids traverse it, same reasoning as the 0711
# home above). mkdir -p also covers a base that one day ships /mnt root-owned
# — the chown/chmod still land. Needs root: the nonroot default user cannot
# create directories under /.
USER 0
RUN --mount=from=tools,source=/out,target=/tools \
  ["/tools/busybox", "sh", "-c", "mkdir -p /mnt && chown 65532:65532 /mnt && chmod 0755 /mnt"]
USER nonroot
COPY ${ARTIFACT_ROOT}/app/ /app/
COPY ${ARTIFACT_ROOT}/node/ /node/
EXPOSE 5000
# Exec-form probe (no shell in the image): Docker uses this whenever the
# stack omits --health-cmd, which is how the CLI gets real readiness on a
# distroless image. node -e reads process.env, so a port override at run
# time keeps the probe honest.
HEALTHCHECK --interval=5s --timeout=5s --retries=10 --start-period=10s \
  CMD ["/node/bin/node", "-e", "fetch('http://127.0.0.1:'+(process.env.SERVER_PORT||5000)+'/status').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))"]
ENTRYPOINT ["/node/bin/node"]
CMD ["dist/start/server.js"]
