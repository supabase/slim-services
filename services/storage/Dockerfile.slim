# syntax=docker/dockerfile:1.7
# Derived image: distroless base + the portable artifact's app/ tree and its
# bundled Node runtime (bin/storage host wrapper is unused in Docker — the
# entrypoint execs the bundled node directly).
ARG BASE_IMAGE=gcr.io/distroless/base-debian13:nonroot

# Static busybox for the one RUN below; bind-mounted at build time only,
# never shipped in the image.
FROM debian:trixie-slim AS tools
RUN apt-get update -y && apt-get install -y --no-install-recommends busybox-static \
  && mkdir -p /out /mnt-skel && cp /bin/busybox /out/busybox

FROM ${BASE_IMAGE}
ARG ARTIFACT_ROOT
WORKDIR /app
ENV NODE_ENV=production
# Legacy volume path: before the image shipped /mnt, local stacks mounted the
# file-backend named volume at /home/nonroot (the base ships it 0700), and
# sidecars running as another uid (imgproxy runs as 999) could not traverse
# into it. Keep re-moding it to 0711 so volumes initialized on that path stay
# traversable; contents remain private by default. A RUN chmod diff layer is
# the only reliable way: COPY onto a directory that already exists in the
# base — with or without --link — merges contents but keeps the existing
# directory's metadata (the image smoke caught /home/nonroot still 0700 both
# ways). The stage runs as nonroot, which owns the directory, so no root
# round-trip is needed.
RUN --mount=from=tools,source=/out,target=/tools ["/tools/busybox", "chmod", "0711", "/home/nonroot"]
# docker.io stacks mount the file-backend volume at /mnt; without the
# directory in the image, docker auto-creates the mountpoint root-owned and
# uid 65532 cannot write a fresh volume. Seed it nonroot-owned and 0755 so
# sidecars under another uid can traverse into it. The base ships no /mnt, so
# this COPY creates it with our ownership (the image smoke asserts uid/mode
# against a base bump shipping one — see the COPY-metadata caveat above).
COPY --from=tools --chown=65532:65532 /mnt-skel/ /mnt/
COPY ${ARTIFACT_ROOT}/app/ /app/
COPY ${ARTIFACT_ROOT}/node/ /node/
EXPOSE 5000
ENTRYPOINT ["/node/bin/node"]
CMD ["dist/start/server.js"]
