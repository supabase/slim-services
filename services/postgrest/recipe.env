SOURCE_DIR="sources/postgrest"
SOURCE_REF="${SOURCE_REF:-v14.16}"
ARTIFACT_BACKEND="image"
# Portable on every target: the linux artifact bundles the full ELF closure
# (glibc loader included) extracted from the upstream image, and the darwin
# artifact consumes the upstream macOS release binary with a bundled Nix
# libpq closure (see services/postgrest/build-host.sh).
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
PORTABLE="true"
# Execution proof at the glibc floor (scripts/floor-check-linux.sh). Top
# level (not inside the darwin block below): applies to linux, harmless on
# darwin since the floor check only ever runs on linux targets.
FLOOR_CHECK_CMD='"$ROOTFS/bin/postgrest" --example >/dev/null && echo floor-ok'
if [[ "$(target_os)" == "darwin" ]]; then
  ARTIFACT_BACKEND="docker-source"
  # Beyond libSystem, the upstream binary links these always-present macOS
  # dyld-cache libraries.
  PORTABLE_HOST_LIBS_JSON='["/usr/lib/libSystem.B.dylib","/usr/lib/libz.1.dylib","/usr/lib/libiconv.2.dylib","/usr/lib/libffi.dylib","/usr/lib/libcharset.1.dylib"]'
fi
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-postgrest/postgrest:$SOURCE_REF}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-scratch}"
ENTRYPOINT_JSON='[]'
CMD_JSON='["/bin/postgrest"]'
# The upstream image's per-arch layouts differ: arm64 ships the binary at
# /usr/bin/postgrest with /bin symlinked to usr/bin, amd64 ships a real /bin
# with no /usr/bin copy. /bin/postgrest resolves on both.
INCLUDE_PATHS=(
  "/bin/postgrest"
)
# The bundled libc (see SPLIT_BUNDLED_GLIBC below) dlopens iconv conversion
# modules at its compiled-in path, /usr/lib/<triplet>/gconv. On a bare host
# that path is never consulted for these copies: the host loader pairs with
# the HOST libc, which reads its own host gconv. But inside the scratch
# Docker image, /usr/lib/<triplet>/gconv IS this artifact's own path once
# extracted at /, and no gconv modules exist there otherwise. Ship the
# SOURCE_IMAGE's own gconv directory (same glibc build as the bundled libc,
# so provenance matches exactly) so bin/postgrest's iconv/iconv_open calls
# resolve conversion modules inside the image. Both triplets are optional:
# the amd64 upstream image is a static-binary scratch image with no gconv
# dir at all, so a missing arm64 or amd64 copy must not fail the build.
OPTIONAL_INCLUDE_PATHS=(
  "/etc/ssl/certs/ca-certificates.crt"
  "/etc/nsswitch.conf"
  "/usr/lib/aarch64-linux-gnu/gconv"
  "/usr/lib/x86_64-linux-gnu/gconv"
)
INCLUDE_PATHS_JSON='["/bin/postgrest"]'
AUTO_ELF_DEPS="true"
AUTO_ELF_BINARIES=(
  "/bin/postgrest"
)
AUTO_ELF_BINARIES_JSON='["/bin/postgrest"]'
# The linux-arm64 bundle keeps its glibc family (libc/libm/loader/...) mixed
# in with the rest of the ELF-deps closure under usr/lib/<triplet>, with no
# rpath on the binary. Docker (bundled loader, no host glibc) papers over
# this because the loader's own default search path happens to include that
# dir, but a bare host run pairs the HOST loader with the bundled non-glibc
# libs and fails to find libpq et al: the host loader never looks in
# usr/lib/<triplet> for them. Split the glibc family into lib/<triplet> (the
# loader's standard search path, works for both the host loader and the
# bundled one) and rpath the binary at the remaining non-glibc closure dir.
SPLIT_BUNDLED_GLIBC="true"
# The split step installs patchelf via apt inside SOURCE_IMAGE, so it
# requires an apt-capable (Debian/Ubuntu) source image.
