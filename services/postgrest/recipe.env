SOURCE_DIR="sources/postgrest"
SOURCE_REF="v14.14"
ARTIFACT_BACKEND="image"
# Darwin host-native artifacts consume the upstream macOS release binary with
# a bundled Nix libpq closure (see services/postgrest/build-host.sh). The
# static Nix experiment below stays Linux-only (macOS has no static linking).
if [[ "$(target_os)" == "darwin" ]]; then
  ARTIFACT_BACKEND="docker-source"
  SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
  PORTABLE="true"
  # Beyond libSystem, the upstream binary links these always-present macOS
  # dyld-cache libraries.
  PORTABLE_HOST_LIBS_JSON='["/usr/lib/libSystem.B.dylib","/usr/lib/libz.1.dylib","/usr/lib/libiconv.2.dylib","/usr/lib/libffi.dylib","/usr/lib/libcharset.1.dylib"]'
fi
NIX_FLAKE="./sources/postgrest"
NIX_BUILD_MODE="nix-build"
NIX_ATTR="postgrestStatic"
NIX_EXPRESSION="static-v14_10-arm64.nix"
NIX_SYSTEM="${NIX_SYSTEM:-}"
NIX_RUNNER="${NIX_RUNNER:-auto}"
NIX_COPY_PATHS=(
  "/bin/postgrest"
)
NIX_COPY_PATHS_JSON='["/bin/postgrest"]'
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-postgrest/postgrest:v14.14}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-scratch}"
ENTRYPOINT_JSON='[]'
CMD_JSON='["/bin/postgrest"]'
INCLUDE_PATHS=(
  "/usr/bin/postgrest"
)
OPTIONAL_INCLUDE_PATHS=(
  "/etc/ssl/certs/ca-certificates.crt"
  "/etc/nsswitch.conf"
)
INCLUDE_PATHS_JSON='["/usr/bin/postgrest"]'
AUTO_ELF_DEPS="true"
AUTO_ELF_BINARIES=(
  "/usr/bin/postgrest"
)
AUTO_ELF_BINARIES_JSON='["/usr/bin/postgrest"]'
WRAPPED_BINARY_SOURCE="/usr/bin/postgrest"
WRAPPED_BINARY_DEST="/bin/postgrest"
