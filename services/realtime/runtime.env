# Low-footprint local-dev defaults, baked as image ENV (overridable at runtime).
# BEAM: one scheduler, no scheduler busy-waiting. Idle busy-wait is the largest
# idle-CPU sink across the BEAM services when running many parallel stacks.
# +fnu is preserved from the upstream default (run.sh falls back to it).
ELIXIR_ERL_OPTIONS=+fnu +S 1:1 +SDio 1 +sbwt none +sbwtdcpu none +sbwtdio none
# Metadata repo pool; holds server-side postgres backends (default 5).
DB_POOL_SIZE=2
