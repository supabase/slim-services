# syntax=docker/dockerfile:1.7
ARG SOURCE_DIR=sources/realtime
ARG ELIXIR_VERSION=1.18
ARG OTP_VERSION=27.3
ARG DEBIAN_VERSION=bookworm-20250929-slim
ARG BUILDER_IMAGE=hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}
ARG RUNNER_IMAGE=debian:${DEBIAN_VERSION}

FROM ${BUILDER_IMAGE} AS builder
ARG SOURCE_DIR
ENV MIX_ENV=prod
WORKDIR /app
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git gnupg \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update -y && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*
RUN mix local.hex --force && mix local.rebar --force
COPY ${SOURCE_DIR}/mix.exs ${SOURCE_DIR}/mix.lock ./
COPY ${SOURCE_DIR}/beacon beacon
RUN mix deps.get --only ${MIX_ENV}
COPY ${SOURCE_DIR}/config/config.exs ${SOURCE_DIR}/config/prod.exs config/
RUN mix deps.compile
COPY ${SOURCE_DIR}/priv priv
COPY ${SOURCE_DIR}/lib lib
COPY ${SOURCE_DIR}/assets assets
RUN cd assets && npm install && cd .. && mix assets.deploy
RUN mix compile
COPY ${SOURCE_DIR}/config/runtime.exs config/
COPY ${SOURCE_DIR}/rel rel
RUN mix release

FROM ${RUNNER_IMAGE} AS runtime-deps
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    busybox ca-certificates file libncurses5 libstdc++6 openssl tini util-linux \
  && update-ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /rootfs/app /rootfs/usr/bin /rootfs/etc/ssl/certs
COPY --from=builder /app/_build/prod/rel/realtime /rootfs/app/
COPY services/realtime/overlay/run.sh /rootfs/app/run.sh
RUN cp /bin/busybox /rootfs/usr/bin/busybox \
  && ln -sf busybox /rootfs/usr/bin/sh \
  && for applet in awk basename cat chmod cut date dd df dirname grep hostname mkdir od readlink rm sed sleep tr uname wc; do ln -sf busybox "/rootfs/usr/bin/${applet}"; done \
  && for bin in env setpriv tini; do cp "$(command -v "${bin}")" "/rootfs/usr/bin/${bin}"; done \
  && cp /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/ca-certificates.crt \
  && printf 'root:x:0:0:root:/root:/usr/sbin/nologin\nnobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin\n' > /rootfs/etc/passwd \
  && printf 'root:x:0:\nnogroup:x:65534:\n' > /rootfs/etc/group \
  && chmod 0755 /rootfs/app/run.sh \
  && chown -R 65534:65534 /rootfs/app \
  && set -eux; \
    scan="$(find /rootfs/usr/bin -type f) $(find /rootfs/app -type f)"; \
    for f in $scan; do file "$f" | grep -q ELF && ldd "$f" || true; done \
      | awk '/=> \/.+ \(/ { print $3 } /^[[:space:]]*\// { print $1 }' \
      | sort -u \
      | xargs -r -I '{}' cp -L --parents '{}' /rootfs \
  && if [ -d /rootfs/lib ]; then mkdir -p /rootfs/usr/lib && cp -a /rootfs/lib/. /rootfs/usr/lib/ && rm -rf /rootfs/lib; fi \
  && for lib in \
      ld-linux-aarch64.so.1 \
      libc.so.6 \
      libcrypto.so.3 \
      libgcc_s.so.1 \
      libm.so.6 \
      libresolv.so.2 \
      libssl.so.3 \
      libstdc++.so.6 \
      libz.so.1 \
      libzstd.so.1; do \
      find /rootfs/usr/lib -name "${lib}" -delete; \
    done

FROM scratch AS artifact
COPY --from=runtime-deps /rootfs/ /
