SOURCE_DIR="sources/realtime"
SOURCE_REF="v2.112.6"
ARTIFACT_BACKEND="docker-source"
# Darwin host-native artifacts build via the repo-owned Nix package in
# services/realtime/nix (mix release + portable dylib packaging). Linux keeps
# the Docker artifact builder above unchanged.
if [[ "$(target_os)" == "darwin" ]]; then
  ARTIFACT_BACKEND="nix"
  NIX_STATUS="candidate"
  NIX_FLAKE="./sources/realtime"
  NIX_ATTR="realtime"
  NIX_BUILD_MODE="nix-build"
  NIX_EXPRESSION="nix"
  NIX_RUNNER="local"
  NIX_OUTPUT_KIND="rootfs"
  NIX_COPY_PATHS_JSON='[]'
  NIX_PACKAGE_OVERLAY="services/realtime/nix"
  NIX_PACKAGE_OVERLAY_DEST="nix"
  SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
  PORTABLE="true"
  ARTIFACT_ARCHIVE_ON_BUILD="${ARTIFACT_ARCHIVE_ON_BUILD:-0}"
fi
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/realtime:v2.112.6}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-gcr.io/distroless/cc-debian13}"
ENTRYPOINT_JSON='["/usr/bin/tini","-s","-g","--","/usr/bin/sh","/app/run.sh"]'
CMD_JSON='["/usr/bin/sh","/app/bin/server"]'
INCLUDE_PATHS=(
  "/app"
  "/usr/bin"
  "/usr/bin/env"
  "/usr/bin/tini"
  "/etc/ssl/certs/ca-certificates.crt"
)
OPTIONAL_INCLUDE_PATHS=(
)
INCLUDE_PATHS_JSON='["/app","/usr/bin","/etc/ssl/certs/ca-certificates.crt"]'
