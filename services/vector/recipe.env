ARTIFACT_BACKEND="upstream-archive"
UPSTREAM_ASSETS_FILE="${UPSTREAM_ASSETS_FILE:-services/vector/upstream-assets.json}"

# Vector's release archives are rooted by target and contain platform-specific
# service-manager files on Linux. Keep all upstream regular files as packaged
# documentation/license data; none are installed as active host config.
if [[ "$(target_os)" == "linux" ]]; then
  UPSTREAM_ARCHIVE_MAPPING_JSON='{"LICENSE":"share/licenses/vector/LICENSE","LICENSE-3rdparty.csv":"share/licenses/vector/LICENSE-3rdparty.csv","NOTICE":"share/licenses/vector/NOTICE","README.md":"share/doc/vector/README.md","bin/vector":"bin/vector","config/README.md":"share/doc/vector/config/README.md","config/examples/docs_example.yaml":"share/doc/vector/config/examples/docs_example.yaml","config/examples/environment_variables.yaml":"share/doc/vector/config/examples/environment_variables.yaml","config/examples/es_s3_hybrid.yaml":"share/doc/vector/config/examples/es_s3_hybrid.yaml","config/examples/file_to_cloudwatch_metrics.yaml":"share/doc/vector/config/examples/file_to_cloudwatch_metrics.yaml","config/examples/file_to_prometheus.yaml":"share/doc/vector/config/examples/file_to_prometheus.yaml","config/examples/namespacing/sinks/es_cluster.yaml":"share/doc/vector/config/examples/namespacing/sinks/es_cluster.yaml","config/examples/namespacing/sinks/s3_archives.yaml":"share/doc/vector/config/examples/namespacing/sinks/s3_archives.yaml","config/examples/namespacing/sources/apache_logs.yaml":"share/doc/vector/config/examples/namespacing/sources/apache_logs.yaml","config/examples/namespacing/transforms/apache_parser.yaml":"share/doc/vector/config/examples/namespacing/transforms/apache_parser.yaml","config/examples/namespacing/transforms/apache_sample.yaml":"share/doc/vector/config/examples/namespacing/transforms/apache_sample.yaml","config/examples/namespacing/vector.yaml":"share/doc/vector/config/examples/namespacing/vector.yaml","config/examples/prometheus_to_console.yaml":"share/doc/vector/config/examples/prometheus_to_console.yaml","config/examples/stdio.yaml":"share/doc/vector/config/examples/stdio.yaml","config/examples/varint_framing_protobuf.yaml":"share/doc/vector/config/examples/varint_framing_protobuf.yaml","config/examples/wrapped_json.yaml":"share/doc/vector/config/examples/wrapped_json.yaml","config/vector.yaml":"share/doc/vector/config/vector.yaml","etc/systemd/hardened-vector.service":"share/doc/vector/systemd/hardened-vector.service","etc/systemd/vector.default":"share/doc/vector/systemd/vector.default","etc/systemd/vector.service":"share/doc/vector/systemd/vector.service","licenses/0BSD":"share/licenses/vector/0BSD","licenses/Apache-2.0":"share/licenses/vector/Apache-2.0","licenses/BSD-2-Clause":"share/licenses/vector/BSD-2-Clause","licenses/BSD-3-Clause":"share/licenses/vector/BSD-3-Clause","licenses/BSL-1.0":"share/licenses/vector/BSL-1.0","licenses/CC0-1.0":"share/licenses/vector/CC0-1.0","licenses/ISC":"share/licenses/vector/ISC","licenses/MIT":"share/licenses/vector/MIT","licenses/MPL-2.0":"share/licenses/vector/MPL-2.0","licenses/OpenSSL":"share/licenses/vector/OpenSSL","licenses/Unicode-DFS-2016":"share/licenses/vector/Unicode-DFS-2016","licenses/Zlib":"share/licenses/vector/Zlib"}'
else
  UPSTREAM_ARCHIVE_MAPPING_JSON='{"LICENSE":"share/licenses/vector/LICENSE","LICENSE-3rdparty.csv":"share/licenses/vector/LICENSE-3rdparty.csv","README.md":"share/doc/vector/README.md","bin/vector":"bin/vector","config/README.md":"share/doc/vector/config/README.md","config/examples/docs_example.yaml":"share/doc/vector/config/examples/docs_example.yaml","config/examples/environment_variables.yaml":"share/doc/vector/config/examples/environment_variables.yaml","config/examples/es_s3_hybrid.yaml":"share/doc/vector/config/examples/es_s3_hybrid.yaml","config/examples/file_to_cloudwatch_metrics.yaml":"share/doc/vector/config/examples/file_to_cloudwatch_metrics.yaml","config/examples/file_to_prometheus.yaml":"share/doc/vector/config/examples/file_to_prometheus.yaml","config/examples/namespacing/sinks/es_cluster.yaml":"share/doc/vector/config/examples/namespacing/sinks/es_cluster.yaml","config/examples/namespacing/sinks/s3_archives.yaml":"share/doc/vector/config/examples/namespacing/sinks/s3_archives.yaml","config/examples/namespacing/sources/apache_logs.yaml":"share/doc/vector/config/examples/namespacing/sources/apache_logs.yaml","config/examples/namespacing/transforms/apache_parser.yaml":"share/doc/vector/config/examples/namespacing/transforms/apache_parser.yaml","config/examples/namespacing/transforms/apache_sample.yaml":"share/doc/vector/config/examples/namespacing/transforms/apache_sample.yaml","config/examples/namespacing/vector.yaml":"share/doc/vector/config/examples/namespacing/vector.yaml","config/examples/prometheus_to_console.yaml":"share/doc/vector/config/examples/prometheus_to_console.yaml","config/examples/stdio.yaml":"share/doc/vector/config/examples/stdio.yaml","config/examples/varint_framing_protobuf.yaml":"share/doc/vector/config/examples/varint_framing_protobuf.yaml","config/examples/wrapped_json.yaml":"share/doc/vector/config/examples/wrapped_json.yaml","config/vector.yaml":"share/doc/vector/config/vector.yaml","licenses/0BSD":"share/licenses/vector/0BSD","licenses/Apache-2.0":"share/licenses/vector/Apache-2.0","licenses/BSD-2-Clause":"share/licenses/vector/BSD-2-Clause","licenses/BSD-3-Clause":"share/licenses/vector/BSD-3-Clause","licenses/BSL-1.0":"share/licenses/vector/BSL-1.0","licenses/CC0-1.0":"share/licenses/vector/CC0-1.0","licenses/ISC":"share/licenses/vector/ISC","licenses/MIT":"share/licenses/vector/MIT","licenses/MPL-2.0":"share/licenses/vector/MPL-2.0","licenses/OpenSSL":"share/licenses/vector/OpenSSL","licenses/Unicode-DFS-2016":"share/licenses/vector/Unicode-DFS-2016","licenses/Zlib":"share/licenses/vector/Zlib"}'
fi
UPSTREAM_ARCHIVE_EXECUTABLES_JSON='["bin/vector"]'
ENTRYPOINT_JSON='[]'
CMD_JSON='["/bin/vector"]'
PORTABLE="true"
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
IMAGE_RELEASE_MODE="mirror"
# Linux archives are statically linked musl binaries. Darwin uses only
# always-present Apple system libraries/frameworks (the default declaration).
if [[ "$(target_os)" == "linux" ]]; then
  PORTABLE_HOST_LIBS_JSON='[]'
fi
