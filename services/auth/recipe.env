SOURCE_DIR="sources/auth"
SOURCE_REF="v2.192.0"
ARTIFACT_BACKEND="docker-source"
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
# Static (CGO_ENABLED=0) Go binary: no host libraries assumed on linux; on
# darwin pure-Go binaries still link the always-present libSystem (default).
PORTABLE="true"
if [[ "${TARGET_OS:-linux}" == "linux" ]]; then
  PORTABLE_HOST_LIBS_JSON='[]'
fi
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/gotrue:v2.192.0}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-scratch}"
ENTRYPOINT_JSON='["/usr/local/bin/auth"]'
CMD_JSON='[]'
INCLUDE_PATHS=(
  "/usr/local/bin/auth"
  "/usr/local/bin/gotrue"
  "/etc/ssl/certs/ca-certificates.crt"
  "/etc/passwd"
  "/etc/group"
)
OPTIONAL_INCLUDE_PATHS=(
)
INCLUDE_PATHS_JSON='["/usr/local/bin/auth","/usr/local/bin/gotrue","/etc/ssl/certs/ca-certificates.crt","/etc/passwd","/etc/group"]'
