# Low-footprint local-dev defaults, baked as image ENV (overridable at runtime).
# Go runtime: cap heap, collect earlier, limit scheduler procs (×25 stacks).
GOMEMLIMIT=64MiB
GOGC=50
GOMAXPROCS=2
# Client pool holds server-side postgres backends; keep it small for local dev.
# GOTRUE_DB_MAX_POOL_SIZE maps to conf.DBConfiguration.MaxPoolSize (0 = unlimited).
GOTRUE_DB_MAX_POOL_SIZE=2
