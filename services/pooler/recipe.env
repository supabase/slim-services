SOURCE_DIR="sources/pooler"
SOURCE_REF="v2.9.10"
ARTIFACT_BACKEND="docker-source"
NIX_STATUS="candidate"
# Darwin host-native artifacts build via the repo-owned Nix package in
# services/pooler/nix (mix release + pgparser Rust NIF + portable dylib
# packaging, adapted from the upstream flake's nix/package.nix). Linux keeps
# the Docker artifact builder unchanged.
if [[ "$(target_os)" == "darwin" ]]; then
  ARTIFACT_BACKEND="nix"
  NIX_FLAKE="./sources/pooler"
  NIX_ATTR="supavisor"
  NIX_BUILD_MODE="nix-build"
  NIX_EXPRESSION="nix"
  NIX_RUNNER="local"
  NIX_OUTPUT_KIND="rootfs"
  NIX_COPY_PATHS_JSON='[]'
  NIX_PACKAGE_OVERLAY="services/pooler/nix"
  NIX_PACKAGE_OVERLAY_DEST="nix"
  SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
  PORTABLE="true"
  ARTIFACT_ARCHIVE_ON_BUILD="${ARTIFACT_ARCHIVE_ON_BUILD:-0}"
fi
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/supavisor:2.9.10}"
# Docker Hub lags behind supavisor releases; compare against the latest
# published tag (results tables mark the percentage as directional).
UPSTREAM_COMPARE_IMAGE="${UPSTREAM_COMPARE_IMAGE:-supabase/supavisor:2.9.7}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-gcr.io/distroless/cc-debian13}"
ENTRYPOINT_JSON='["/usr/bin/tini","-s","-g","--","/usr/bin/sh","/app/limits.sh"]'
CMD_JSON='["/usr/bin/sh","/app/bin/server"]'
INCLUDE_PATHS=(
  "/app"
  "/usr/bin"
  "/usr/bin/tini"
  "/usr/bin/env"
  "/etc/ssl/certs/ca-certificates.crt"
)
INCLUDE_PATHS_JSON='["/app","/usr/bin","/etc/ssl/certs/ca-certificates.crt"]'
