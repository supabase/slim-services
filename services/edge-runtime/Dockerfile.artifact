# syntax=docker/dockerfile:1.7
# Docker-hosted Nix build for linux targets (used when the host Nix system
# does not match the target, e.g. building linux/arm64 artifacts on macOS).
ARG SOURCE_DIR=sources/edge-runtime
ARG NIX_ATTR=edge-runtime
ARG NIX_SYSTEM=aarch64-linux

FROM nixos/nix:2.24.9 AS builder
ARG SOURCE_DIR
ARG NIX_ATTR
ARG NIX_SYSTEM
WORKDIR /src
COPY ${SOURCE_DIR}/ ./
# Apply the repo-owned portable package overlay (the local Nix runner does the
# same through a temporary source export; the Docker runner must do it here).
COPY services/edge-runtime/nix/edge-runtime.nix nix/edge-runtime.nix
# The submodule's .git pointer references the host worktree; drop it so the
# flake is fetched as a plain path instead of a (broken) git repository.
RUN rm -rf .git
RUN nix --extra-experimental-features "nix-command flakes" build \
      ".#packages.${NIX_SYSTEM}.${NIX_ATTR}" --out-link /out \
  && mkdir -p /rootfs \
  && cp -RL /out/. /rootfs/ \
  && chmod -R u+w /rootfs

FROM scratch AS artifact
COPY --from=builder /rootfs/ /
