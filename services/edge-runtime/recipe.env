SOURCE_DIR="sources/edge-runtime"
SOURCE_REF="v1.73.15"
ARTIFACT_BACKEND="nix"
NIX_STATUS="primary"
NIX_FLAKE="./sources/edge-runtime"
NIX_ATTR="edge-runtime"
NIX_SYSTEM="${NIX_SYSTEM:-aarch64-linux}"
NIX_RUNNER="${NIX_RUNNER:-docker}"
NIX_COPY_PATHS=(
  "/bin/.edge-runtime-wrapped:/usr/local/bin/edge-runtime"
  "/lib:/usr/local/lib"
)
NIX_COPY_PATHS_JSON='["/bin/.edge-runtime-wrapped:/usr/local/bin/edge-runtime","/lib:/usr/local/lib"]'
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/edge-runtime:v1.73.15}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-gcr.io/distroless/base-debian13:nonroot}"
ENTRYPOINT_JSON='["/usr/local/bin/edge-runtime"]'
CMD_JSON='[]'
ARTIFACT_BUILD_ARGS=(
  "ONNXRUNTIME_VERSION=${ONNXRUNTIME_VERSION:-1.20.1}"
  "GIT_V_TAG=${GIT_V_TAG:-v1.73.15}"
  "PROFILE=${PROFILE:-release}"
  "FEATURES=${FEATURES:-}"
)
INCLUDE_PATHS=(
  "/usr/local/bin/edge-runtime"
  "/usr/local/lib"
  "/etc/ssl/certs/ca-certificates.crt"
)
INCLUDE_PATHS_JSON='["/usr/local/bin/edge-runtime","/usr/local/lib","/etc/ssl/certs/ca-certificates.crt"]'
