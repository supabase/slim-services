IMAGE_RELEASE_MODE="mirror"
MIRROR_SMOKE_SCRIPT="services/imgproxy/smoke.sh"
EXTERNAL_SOURCE_LOCK_SCRIPT="services/imgproxy/external-source-lock.sh"
ARTIFACT_BACKEND="nix"
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
PORTABLE="true"
case "$(uname -s)" in
  Darwin) PORTABLE_HOST_LIBS_JSON='["/usr/lib/libSystem.B.dylib","/System/Library/Frameworks"]' ;;
  *) PORTABLE_HOST_LIBS_JSON='[]' ;;
esac
FLOOR_CHECK_CMD='"$ROOTFS/bin/vips" --version >/dev/null && echo floor-ok'
BASE_IMAGE="debian:bookworm-slim"
ENTRYPOINT_JSON='[]'
CMD_JSON='["/bin/imgproxy"]'
