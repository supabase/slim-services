# Mailpit local-dev defaults. Smoke callers override the addresses and database
# path so every invocation owns independent ports and explicit state.
MP_UI_BIND_ADDR=0.0.0.0:8025
MP_SMTP_BIND_ADDR=0.0.0.0:1025
MP_POP3_BIND_ADDR=0.0.0.0:1110
MP_POP3_AUTH=smoke:smoke-password
MP_SMTP_DISABLE_RDNS=true
MP_DATABASE=/tmp/mailpit.db
