ARTIFACT_BACKEND="upstream-archive"
: "${UPSTREAM_ASSETS_FILE:?UPSTREAM_ASSETS_FILE must be supplied by workflow context}"
UPSTREAM_ARCHIVE_MAPPING_JSON='{"mailpit":"bin/mailpit","LICENSE":"share/licenses/mailpit/LICENSE","README.md":"share/doc/mailpit/README.md"}'
UPSTREAM_ARCHIVE_EXECUTABLES_JSON='["mailpit"]'
ENTRYPOINT_JSON='[]'
CMD_JSON='["/bin/mailpit"]'
PORTABLE="true"
RUNTIME_REQUIRES=""
if [[ "$(target_os)" == "linux" ]]; then
  RUNTIME_REQUIRES="glibc"
fi
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
IMAGE_RELEASE_MODE="mirror"
# Execution proof at the supported Ubuntu 22.04/glibc 2.35 floor.
FLOOR_CHECK_CMD='"$ROOTFS/bin/mailpit" --version >/dev/null && echo floor-ok'
