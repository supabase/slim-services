# syntax=docker/dockerfile:1.7
# Derived image: distroless base + the portable postgres artifact + entry
# wiring (HOST_NATIVE_PLAN.md, native-first — no exceptions). The artifact
# bundles every non-glibc library with $ORIGIN rpaths, so the glibc-only
# base is enough. Runs unprivileged (uid 65532) — no gosu/root phase.
#
# The artifact ships the full PG17 extension set (installed, not enabled:
# only the minimal shared_preload_libraries set is on by default, so the
# low-footprint profile is unaffected).
ARG BASE_IMAGE=gcr.io/distroless/base-debian13:nonroot

FROM debian:trixie-slim AS tools
RUN apt-get update -y && apt-get install -y --no-install-recommends busybox bash ca-certificates locales \
  # The shared recipe pins lc_* = en_US.UTF-8 (docker.io parity). The bundle's
  # binaries run against the SYSTEM glibc (nix glibc's LOCALE_ARCHIVE patch
  # does not apply), so generate the locale with THIS Debian release's own
  # localedef — same glibc as the distroless base — at the system path.
  && localedef -i en_US -f UTF-8 en_US.UTF-8 \
  && mkdir -p /out/usr/bin /out/usr/lib /out/etc/ssl/certs /out/usr/lib/locale /pgdata-skel/data \
  && cp /usr/lib/locale/locale-archive /out/usr/lib/locale/locale-archive \
  && cp /usr/bin/busybox /out/usr/bin/busybox \
  && for applet in sh basename cat chmod cp cut date dirname env grep gunzip head id mkdir od readlink rm sed sleep tr uname wc; do \
       ln -sf busybox "/out/usr/bin/${applet}"; \
     done \
  # The bundle's supabase-postgres-init.sh is bash; bring bash + its one
  # non-glibc library.
  && cp /bin/bash /out/usr/bin/bash \
  && cp -L "$(ldd /bin/bash | awk '/libtinfo/ { print $3 }')" /out/usr/lib/ \
  && cp /etc/ssl/certs/ca-certificates.crt /out/etc/ssl/certs/ca-certificates.crt \
  && chmod 0700 /pgdata-skel/data

FROM ${BASE_IMAGE}
ARG ARTIFACT_ROOT
COPY --from=tools /out/ /
COPY --from=tools --chown=65532:65532 /pgdata-skel/ /var/lib/postgresql/
COPY --chown=65532:65532 ${ARTIFACT_ROOT}/ /opt/postgres/
COPY services/postgres/overlay/entry.sh /usr/local/bin/entry.sh
# LANG/LC_ALL mirror Dockerfile-supabase so initdb's libc locale fields match
# the docker.io image; the locale itself resolves via the system archive the
# tools stage generated (see stage-shared-config.sh for the native fallback).
ENV PGDATA=/var/lib/postgresql/data \
    POSTGRES_USER=supabase_admin \
    POSTGRES_DB=postgres \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    PATH=/opt/postgres/bin:/usr/local/bin:/usr/bin:/bin
EXPOSE 5432
ENTRYPOINT ["/usr/bin/sh", "/usr/local/bin/entry.sh"]
