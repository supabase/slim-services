# supabase/postgres is a Nix-based image; the artifact is produced by pruning
# the published image (docker-image backend), not by a source submodule build.
ARTIFACT_BACKEND="docker-image"
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/postgres:17.6.1.143}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-scratch}"
ENTRYPOINT_JSON='["/usr/local/bin/docker-entrypoint.sh"]'
CMD_JSON='["postgres","-D","/etc/postgresql"]'
INCLUDE_PATHS=(
)
OPTIONAL_INCLUDE_PATHS=(
)
INCLUDE_PATHS_JSON='[]'
