SOURCE_DIR="sources/postgres"
SOURCE_REF="17.6.1.143"
# Native-first, no exceptions (user directive): the portable artifact —
# upstream's psql_17_cli_portable with the slim-services overlay adding
# pgvector (services/postgres/nix/packages/) — is the single source of truth
# on every target, and the Docker image is derived from it via
# Dockerfile.slim. This diverges from upstream supabase/postgres bundling:
# the image ships the curated CLI extension set + pgvector, not the full
# 31-extension flavour.
ARTIFACT_BACKEND="nix"
NIX_STATUS="primary"
NIX_FLAKE="./sources/postgres"
NIX_ATTR="psql_17_cli_portable"
NIX_BUILD_MODE="flake"
NIX_RUNNER="${NIX_RUNNER:-auto}"
NIX_OUTPUT_KIND="rootfs"
NIX_COPY_PATHS_JSON='[]'
NIX_PACKAGE_OVERLAY="services/postgres/nix"
NIX_PACKAGE_OVERLAY_DEST="nix"
# --accept-flake-config enables upstream's public binary cache
# (nix-postgres-artifacts); the unmodified postgres/extension derivations
# substitute instead of compiling.
NIX_BUILD_COMMAND_TEMPLATE='nix --extra-experimental-features "nix-command flakes" build "$NIX_INSTALLABLE" --out-link "$NIX_OUT_LINK" --accept-flake-config'
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
PORTABLE="true"
ARTIFACT_ARCHIVE_ON_BUILD="${ARTIFACT_ARCHIVE_ON_BUILD:-0}"
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/postgres:17.6.1.143}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-gcr.io/distroless/base-debian13:nonroot}"
RESULTS_NOTE="curated extensions + pgvector"
ENTRYPOINT_JSON='["/usr/bin/sh","/usr/local/bin/entry.sh"]'
CMD_JSON='[]'
