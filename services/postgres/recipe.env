SOURCE_DIR="sources/postgres"
SOURCE_REF="${SOURCE_REF:-17.6.1.158}"
# Native-first, no exceptions (user directive): the portable artifact —
# repo-owned major-specific psql_{15,17}_cli_portable Nix derivations with the
# slim-services overlay (services/postgres/nix/packages/) shipping the full extension set —
# is the single source of truth on every target, and the Docker image is
# derived from it via the Nix dockerTools image. Extensions are installed, with preload
# behavior following the matching upstream image's shared configuration.
ARTIFACT_BACKEND="nix"
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
PORTABLE="true"
# Execution proof at the glibc floor (scripts/floor-check-linux.sh): the check
# evaluates this command with /bin/bash -c, provided by the floor image.
FLOOR_CHECK_CMD='"$ROOTFS/bin/postgres" --version && "$ROOTFS/bin/initdb" --version'
ARTIFACT_ARCHIVE_ON_BUILD="${ARTIFACT_ARCHIVE_ON_BUILD:-0}"
# Docker Hub defines release eligibility. SOURCE_REF may therefore be the
# immutable image-provenance commit while VERSION remains the published tag.
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/postgres:${VERSION:-$SOURCE_REF}}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
# Tag SOURCE_IMAGE_DIGEST was recorded for. Not SOURCE_REF: release CI
# overwrites SOURCE_REF to VERSION.
IDENTITY_SOURCE_TAG="17.6.1.158"
SOURCE_IMAGE_DIGEST="${SOURCE_IMAGE_DIGEST:-sha256:99b1729aeb0bac314445024fc149fbd39306170b61dd50800ccf180327ab3459}"
RESULTS_NOTE="all PostgreSQL extensions for the selected major, matching upstream preload configuration"
ENTRYPOINT_JSON='["/usr/local/bin/docker-entrypoint.sh"]'
CMD_JSON='["postgres","-D","/etc/postgresql"]'
