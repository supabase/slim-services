# supabase/postgres is a Nix-based image; the Linux artifact is produced by
# pruning the published image (docker-image backend) and intentionally keeps
# the full extension flavour — the documented native-first exception in
# HOST_NATIVE_PLAN.md.
SOURCE_DIR="sources/postgres"
SOURCE_REF="17.6.1.143"
ARTIFACT_BACKEND="docker-image"
# Darwin host-native artifacts build upstream's own relocatable package
# (psql_17_cli_portable — the same build the Supabase CLI ships) with the
# slim-services overlay adding pgvector to the CLI extension set
# (services/postgres/nix/packages/). --accept-flake-config enables upstream's
# public binary cache; the unmodified extension/postgres derivations hit it.
if [[ "$(target_os)" == "darwin" ]]; then
  ARTIFACT_BACKEND="nix"
  NIX_STATUS="candidate"
  NIX_FLAKE="./sources/postgres"
  NIX_ATTR="psql_17_cli_portable"
  NIX_BUILD_MODE="flake"
  NIX_RUNNER="local"
  NIX_OUTPUT_KIND="rootfs"
  NIX_COPY_PATHS_JSON='[]'
  NIX_PACKAGE_OVERLAY="services/postgres/nix"
  NIX_PACKAGE_OVERLAY_DEST="nix"
  NIX_BUILD_COMMAND_TEMPLATE='nix --extra-experimental-features "nix-command flakes" build "$NIX_INSTALLABLE" --out-link "$NIX_OUT_LINK" --accept-flake-config'
  SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
  PORTABLE="true"
  ARTIFACT_ARCHIVE_ON_BUILD="${ARTIFACT_ARCHIVE_ON_BUILD:-0}"
fi
# The per-file buildkit local exporter stalls on this rootfs (very large Nix
# store file count); stream the artifact stage as a tarball instead.
ARTIFACT_EXPORT="tar"
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/postgres:17.6.1.143}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
# Manifest-list digest of the tag above; pins the build against upstream tag
# republication and stale local caches (provenance, like SOURCE_REF for
# submodule builds). Update together with UPSTREAM_IMAGE.
SOURCE_IMAGE_DIGEST="${SOURCE_IMAGE_DIGEST:-sha256:80d7b27c3e8d77cfa7226eee9508671796da214781ff15a35b3670d7ad5ee453}"
BASE_IMAGE="${BASE_IMAGE:-scratch}"
RESULTS_NOTE="all extensions"
ENTRYPOINT_JSON='["/usr/local/bin/slim-entrypoint.sh"]'
CMD_JSON='["postgres","-D","/etc/postgresql"]'
