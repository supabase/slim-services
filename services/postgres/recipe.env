SOURCE_DIR="sources/postgres"
SOURCE_REF="${SOURCE_REF:-17.6.1.158}"
# Native-first, no exceptions (user directive): the portable artifact —
# upstream's psql_17_cli_portable with the slim-services overlay
# (services/postgres/nix/packages/) shipping the FULL PG17 extension set —
# is the single source of truth on every target, and the Docker image is
# derived from it via Dockerfile.slim. Extensions are installed but not
# enabled: only the minimal shared_preload_libraries set is on by default,
# preserving the low-footprint profile.
ARTIFACT_BACKEND="nix"
NIX_STATUS="primary"
NIX_FLAKE="./sources/postgres"
NIX_ATTR="psql_17_cli_portable"
NIX_BUILD_MODE="flake"
NIX_RUNNER="${NIX_RUNNER:-auto}"
NIX_OUTPUT_KIND="rootfs"
NIX_COPY_PATHS_JSON='[]'
NIX_PACKAGE_OVERLAY="services/postgres/nix"
NIX_PACKAGE_OVERLAY_DEST="nix"
NIX_AUXILIARY_OVERLAYS=(
  "nix/portable-postgres:nix/portable-postgres"
)
# Upstream's public binary cache (substituter + signing key straight from
# the pinned source's nix/docs/start-here.md): the unmodified
# postgres/extension derivations substitute instead of compiling. The flags
# must be explicit — the upstream flake declares no nixConfig, so
# --accept-flake-config alone never enabled the cache (it stays so an
# upstream nixConfig applies if one lands). CLI-passed substituter flags
# only apply on trusted/single-user Nix (CI's nix-quick-install-action);
# on a local multi-user daemon install, add the same two lines to nix.conf
# per the pinned source's nix/docs/start-here.md.
NIX_BUILD_COMMAND_TEMPLATE='nix --extra-experimental-features "nix-command flakes" build "$NIX_INSTALLABLE" --out-link "$NIX_OUT_LINK" --accept-flake-config --extra-substituters https://nix-postgres-artifacts.s3.amazonaws.com --extra-trusted-public-keys nix-postgres-artifacts:dGZlQOvKcNEjvT7QEAJbcV6b6uk7VF/hWMjhYleiaLI='
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
PORTABLE="true"
# Execution proof at the glibc floor (scripts/floor-check-linux.sh): wrapper
# scripts are bash; the floor image (ubuntu:22.04) has bash.
FLOOR_CHECK_CMD='"$ROOTFS/bin/postgres" --version && "$ROOTFS/bin/initdb" --version'
ARTIFACT_ARCHIVE_ON_BUILD="${ARTIFACT_ARCHIVE_ON_BUILD:-0}"
# Docker Hub defines release eligibility. SOURCE_REF may therefore be the
# immutable image-provenance commit while VERSION remains the published tag.
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/postgres:${VERSION:-$SOURCE_REF}}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
# Tag SOURCE_IMAGE_DIGEST was recorded for. Not SOURCE_REF: release CI
# overwrites SOURCE_REF to VERSION.
IDENTITY_SOURCE_TAG="17.6.1.158"
SOURCE_IMAGE_DIGEST="${SOURCE_IMAGE_DIGEST:-sha256:99b1729aeb0bac314445024fc149fbd39306170b61dd50800ccf180327ab3459}"
# Root variant: empty Config.User, matching the docker.io pin. :nonroot
# would bake USER nonroot and break leftover-volume interchange.
BASE_IMAGE="${BASE_IMAGE:-gcr.io/distroless/base-debian13}"
RESULTS_NOTE="all PG17 extensions, minimal preload"
ENTRYPOINT_JSON='["/usr/local/bin/docker-entrypoint.sh"]'
CMD_JSON='["postgres","-D","/etc/postgresql"]'
