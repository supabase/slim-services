# syntax=docker/dockerfile:1.7
# Derived image: distroless Node base + the portable artifact's app/ tree
# (the bin/pgmeta host wrapper is unused in Docker — the base image provides
# the runtime).
ARG BASE_IMAGE=gcr.io/distroless/nodejs20-debian13:nonroot
FROM ${BASE_IMAGE}
ARG ARTIFACT_ROOT
WORKDIR /usr/src/app
ENV PG_META_PORT=8080
COPY ${ARTIFACT_ROOT}/app/ /usr/src/app/
EXPOSE 8080
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["dist/server/server.js"]
