# syntax=docker/dockerfile:1.7
ARG SOURCE_DIR=sources/pgmeta
ARG ROLLDOWN_VERSION=1.0.0-rc.17

FROM node:20-bookworm-slim AS build
ARG SOURCE_DIR
ARG ROLLDOWN_VERSION
WORKDIR /usr/src/app
RUN npm install -g "rolldown@${ROLLDOWN_VERSION}"
COPY ${SOURCE_DIR}/package.json ${SOURCE_DIR}/package-lock.json ./
RUN npm clean-install
COPY ${SOURCE_DIR}/ ./
COPY services/pgmeta/overlay /tmp/slim-overlay
RUN npm run build \
  && cp /tmp/slim-overlay/rolldown.config.mjs ./rolldown.config.mjs \
  && cp /tmp/slim-overlay/bundle-manifest.mjs ./bundle-manifest.mjs \
  && mkdir -p ./scripts \
  && cp /tmp/slim-overlay/scripts/prepare-bundle-dist.mjs ./scripts/prepare-bundle-dist.mjs \
  && rolldown -c ./rolldown.config.mjs \
  && node ./scripts/prepare-bundle-dist.mjs \
  && find /usr/src/app/dist-bundle /usr/src/app/dist-bundle/node_modules \
      \( -name '*.d.ts' -o -name '*.d.ts.map' -o -name '*.map' -o -name '*.md' -o -name '*.markdown' -o -name 'README*' \) \
      -type f -print0 | xargs -0r rm -f \
  && find /usr/src/app/dist-bundle/node_modules \
      \( -path '*/test/*' -o -path '*/tests/*' -o -path '*/__tests__/*' -o -path '*/example/*' -o -path '*/examples/*' -o -path '*/benchmark/*' -o -path '*/benchmarks/*' \) \
      -print0 | xargs -0r rm -rf

FROM scratch AS artifact
COPY --from=build /usr/src/app/dist-bundle/package.json /usr/src/app/package.json
COPY --from=build /usr/src/app/dist-bundle/server /usr/src/app/dist/server
COPY --from=build /usr/src/app/dist-bundle/node_modules /usr/src/app/node_modules
