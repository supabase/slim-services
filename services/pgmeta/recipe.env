SOURCE_DIR="sources/pgmeta"
SOURCE_REF="v0.96.6"
ARTIFACT_BACKEND="docker-source"
# Darwin host-native artifacts: JS bundle + bin/pgmeta wrapper resolving the
# shared Node runtime (HOST_NATIVE_PLAN.md Phase 4, Option A). Built by
# services/pgmeta/build-host.sh; linux keeps the Docker builder unchanged.
if [[ "$(target_os)" == "darwin" ]]; then
  SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
  PORTABLE="true"
  RUNTIME_REQUIRES="node>=20"
fi
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/postgres-meta:v0.96.6}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-gcr.io/distroless/nodejs20-debian13:nonroot}"
ENTRYPOINT_JSON='["/nodejs/bin/node"]'
CMD_JSON='["dist/server/server.js"]'
INCLUDE_PATHS=(
  "/usr/src/app/package.json"
  "/usr/src/app/dist"
  "/usr/src/app/node_modules"
)
INCLUDE_PATHS_JSON='["/usr/src/app/package.json","/usr/src/app/dist","/usr/src/app/node_modules"]'
