# Low-footprint local-dev defaults, baked as image ENV (overridable at runtime).
# BEAM: one scheduler, no scheduler busy-waiting (largest idle-CPU sink at 25x).
ELIXIR_ERL_OPTIONS=+S 1:1 +SDio 1 +sbwt none +sbwtdcpu none +sbwtdio none
# Repo pool holds server-side postgres backends (single-tenant local dev).
DB_POOL_SIZE=2
LOGFLARE_PUBSUB_POOL_SIZE=2
