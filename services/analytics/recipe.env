SOURCE_DIR="sources/analytics"
SOURCE_REF="v1.46.0"
ARTIFACT_BACKEND="docker-source"
# Darwin host-native artifacts build via the repo-owned Nix package in
# services/analytics/nix (mix release + 4 in-tree rustler NIFs + seeded
# rustler_precompiled cache + portable dylib packaging). Linux keeps the
# Docker artifact builder unchanged.
if [[ "$(target_os)" == "darwin" ]]; then
  ARTIFACT_BACKEND="nix"
  NIX_STATUS="candidate"
  NIX_FLAKE="./sources/analytics"
  NIX_ATTR="logflare"
  NIX_BUILD_MODE="nix-build"
  NIX_EXPRESSION="nix"
  NIX_RUNNER="local"
  NIX_OUTPUT_KIND="rootfs"
  NIX_COPY_PATHS_JSON='[]'
  NIX_PACKAGE_OVERLAY="services/analytics/nix"
  NIX_PACKAGE_OVERLAY_DEST="nix"
  SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
  PORTABLE="true"
  ARTIFACT_ARCHIVE_ON_BUILD="${ARTIFACT_ARCHIVE_ON_BUILD:-0}"
fi
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/logflare:1.46.0}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-gcr.io/distroless/cc-debian13:nonroot}"
ENTRYPOINT_JSON='["/usr/bin/sh","/opt/app/rel/logflare/bin/run.sh"]'
CMD_JSON='[]'
INCLUDE_PATHS=(
  "/opt/app"
  "/usr/bin"
  "/etc/ssl/certs/ca-certificates.crt"
)
INCLUDE_PATHS_JSON='["/opt/app","/usr/bin","/etc/ssl/certs/ca-certificates.crt"]'
