SOURCE_DIR="sources/studio"
SOURCE_REF="${SOURCE_REF:-022b374f2dbd7dab46b3fd5aab92d827b7fa4059}"
# Studio publishes date+commit Docker tags rather than GitHub releases. The
# automatic release workflow resolves this tag to SOURCE_REF before building.
STUDIO_RELEASE="${STUDIO_RELEASE:-2026.08.03-sha-022b374}"
ARTIFACT_BACKEND="docker-source"
ARTIFACT_SOURCE_BUILD="host"
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
PORTABLE="true"
FLOOR_CHECK_CMD='"$ROOTFS/node/bin/node" --version && addons=$(find "$ROOTFS/app" -type f -name "*.node") && [ -n "$addons" ] && for a in $addons; do echo "loading $a"; "$ROOTFS/node/bin/node" -e "require(process.argv[1])" "$a"; done && "$ROOTFS/node/bin/node" -e "require(\"node:dns\").lookup(process.argv[1], (err, addr) => { if (err) { console.error(err); process.exit(1); } console.log(\"dns.lookup\", addr); })" slim-floor-check'
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/studio:$STUDIO_RELEASE}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
BASE_IMAGE="${BASE_IMAGE:-gcr.io/distroless/base-debian13:nonroot}"
ENTRYPOINT_JSON='["/node/bin/node","/app/apps/studio/docker-entrypoint.mjs"]'
CMD_JSON='["/node/bin/node","apps/studio/server.js"]'
