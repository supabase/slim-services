SOURCE_DIR="sources/studio"
SOURCE_REF="${SOURCE_REF:-022b374f2dbd7dab46b3fd5aab92d827b7fa4059}"
# Studio publishes date+commit Docker tags rather than GitHub releases. The
# automatic release workflow resolves this tag to SOURCE_REF before building.
STUDIO_RELEASE="${STUDIO_RELEASE:-2026.08.03-sha-022b374}"
ARTIFACT_BACKEND="nix"
SUPPORTS_DIRECT_ARTIFACT_SMOKE="true"
PORTABLE="true"
# The self-hosted artifact ships no native addons by design (sharp/@img are
# excluded, see services/studio/REPORT.md); load any *.node found (zero is
# fine) instead of requiring at least one, but assert its main entry exists
# and that no excluded sharp/@img trace slipped back in.
FLOOR_CHECK_CMD='"$ROOTFS/node/bin/node" --version && [ -f "$ROOTFS/app/apps/studio/server.js" ] && addons=$(find "$ROOTFS/app" -type f -name "*.node") && for a in $addons; do echo "loading $a"; "$ROOTFS/node/bin/node" -e "require(process.argv[1])" "$a"; done && sharp_trace=$(find "$ROOTFS/app" -type d -name sharp -o -type d -name "@img" -o -type f -path "*/@img/*.node") && if [ -n "$sharp_trace" ]; then printf "excluded sharp/@img trace present:\n%s\n" "$sharp_trace" >&2; exit 1; fi && "$ROOTFS/node/bin/node" -e "require(\"node:dns\").lookup(process.argv[1], (err, addr) => { if (err) { console.error(err); process.exit(1); } console.log(\"dns.lookup\", addr); })" slim-floor-check'
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-supabase/studio:$STUDIO_RELEASE}"
SOURCE_IMAGE="${SOURCE_IMAGE:-$UPSTREAM_IMAGE}"
ENTRYPOINT_JSON='["/slim-runtime/bin/studio"]'
CMD_JSON='["/node/bin/node","apps/studio/server.js"]'
