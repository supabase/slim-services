# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=gcr.io/distroless/base-debian13:nonroot
FROM ${BASE_IMAGE}
ARG ARTIFACT_ROOT
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY ${ARTIFACT_ROOT}/app/ /app/
COPY ${ARTIFACT_ROOT}/node/ /node/
EXPOSE 3000
# Next's standalone server.js binds to $HOSTNAME, and Docker injects the
# container ID as HOSTNAME, so without this the server listens only on the
# container IP and loopback probes (the HEALTHCHECK below, docker.io-style
# localhost checks) get connection refused. Bake the canonical Next.js
# Docker bind; a runtime -e HOSTNAME still overrides it.
ENV HOSTNAME=0.0.0.0
# Exec-form probe — Docker uses it when the stack omits --health-cmd; node -e
# reads process.env, so runtime port overrides stay honest. Studio is the
# slowest boot in the stack — give it a generous start period.
HEALTHCHECK --interval=5s --timeout=10s --retries=10 --start-period=60s \
  CMD ["/node/bin/node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/platform/profile').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))"]
ENTRYPOINT ["/node/bin/node", "/app/apps/studio/docker-entrypoint.mjs"]
CMD ["/node/bin/node", "apps/studio/server.js"]
