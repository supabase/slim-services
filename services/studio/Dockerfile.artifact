# syntax=docker/dockerfile:1.7
ARG SOURCE_DIR=sources/studio

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends build-essential ca-certificates git python3 \
  && rm -rf /var/lib/apt/lists/* \
  && update-ca-certificates
RUN npm install -g pnpm@10.24.0
WORKDIR /app

FROM base AS turbo
ARG SOURCE_DIR
COPY ${SOURCE_DIR}/ ./
RUN pnpm dlx turbo@2.9.3 prune studio --docker

FROM base AS deps
COPY --from=turbo /app/out/json ./
COPY --from=turbo /app/out/pnpm-lock.yaml ./
COPY --from=turbo /app/patches ./patches
RUN pnpm install --frozen-lockfile

FROM deps AS builder
COPY --from=turbo /app/out/full ./
ENV NODE_OPTIONS=--max-old-space-size=4096
ENV NEXT_PRIVATE_BUILD_WORKER_COUNT=1
RUN pnpm --filter studio exec next build

FROM debian:bookworm-slim AS pack
WORKDIR /rootfs/app
COPY --from=builder /app/apps/studio/public ./apps/studio/public
COPY --from=builder /app/apps/studio/.next/standalone ./
COPY --from=builder /app/apps/studio/.next/static ./apps/studio/.next/static
COPY services/studio/overlay/docker-entrypoint.mjs ./apps/studio/docker-entrypoint.mjs
RUN find /rootfs/app -type f \( -name '*.nft.json' -o -name '*.map' \) -delete

FROM scratch AS artifact
COPY --from=pack /rootfs/ /
