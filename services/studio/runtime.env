# Low-footprint local-dev defaults, baked as image ENV (overridable at runtime).
# Studio is the heaviest Node process in the stack; cap the V8 heap and keep
# semi-spaces small. Raise via `docker run -e NODE_OPTIONS=...` if a workload
# genuinely needs more.
NODE_OPTIONS=--max-old-space-size=192 --max-semi-space-size=2
NEXT_TELEMETRY_DISABLED=1
